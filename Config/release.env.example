# Copy to Config/release.env, fill in, never commit.
# Signing identity (already installed):
LUCAS_SIGN_IDENTITY="Developer ID Application: wei bo (C49X44B3DA)"
# Created with: xcrun notarytool store-credentials lucas-notary --apple-id ... --team-id ...
# The profile lives in the login keychain, so no password is passed on the command line.
LUCAS_NOTARY_PROFILE="lucas-notary"
# Public HTTPS locations:
LUCAS_FEED_URL="https://updates.okcue.app/lucas/appcast.xml"
LUCAS_DOWNLOAD_PREFIX="https://updates.okcue.app/lucas/"
# rsync target, e.g. user@host:/var/www/updates/lucas/
LUCAS_DEPLOY_TARGET="ubuntu@43.132.224.242:/var/www/updates/lucas/"
LUCAS_SSH_KEY="$HOME/Desktop/japlosv2/clone/.secrets/deploy_key"
